  "flows": [
    {
      "id": "canvas-to-gtfix",
      "from": "canvas",
      "to": "gtfix",
      "label": "realised warp",
      "classification": "synthetic",
      "variant": "emphasis"
    },
    {
      "id": "gtfix-to-disk",
      "from": "gtfix",
      "to": "disk",
      "label": "stored pairs",
      "classification": "finite"
    },
