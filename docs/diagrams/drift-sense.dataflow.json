      "variant": "emphasis"
    },
    {
      "id": "train-to-shipped",
      "from": "trainloop",
      "to": "shipped",
      "label": "candidate ckpt",
      "classification": "gated",
      "variant": "emphasis",
      "labelDy": 85
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Why the generator is re-run",
      "items": [
        "The upstream generator writes ground truth in pre-imaging coordinates",
        "It then warps the search frame with raster drift and barrel distortion without updating the label",
        "correct_gt re-runs the same imaging, captures the realised warp, and maps the label through it"
      ]
    },
    {
      "dot": "emerald",
      "title": "Generating beats storing",
      "items": [
        "Fixed-pool runs overfit: training loss kept falling while held-out accuracy plateaued",
        "Another 24,000 stored pairs would have cost roughly 17 GB of disk",
        "Workers synthesise a fresh scene per sample, so the model cannot memorise the training set"
      ]
    },
    {
      "dot": "amber",
      "title": "One sample definition",
      "items": [
        "build_sample is shared by the on-disk and the streaming path",
        "Pose is canonicalised with jitter sized to the search's measured residual error",
        "Targets are a Gaussian centre heatmap plus a sub-cell offset field"
      ]
    }
  ]
}