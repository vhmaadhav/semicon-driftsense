  "cards": [
    {
      "dot": "cyan",
      "title": "Why several hypotheses",
      "items": [
        "Correlation against a periodic layout is multi-peaked in scale",
        "A wrong magnification can outscore the true one on a low-resolution probe",
        "The top few local maxima of the coarse sweep are kept, not just the best"
      ]
    },
    {
      "dot": "emerald",
      "title": "Why native resolution decides",
      "items": [
        "A wrong scale basin correlates near zero at full resolution",
        "The right one sits around 0.9, so the choice becomes easy",
        "Refinement never runs in the canonical frame, so no resampling blur is inherited"
      ]
    },
    {
      "dot": "amber",
      "title": "Output contract",
      "items": [
        "Every pair_id emits exactly one row, in input order",
        "found = 0 writes zeros in every pose column",
        "A pair that raises or times out declines rather than disappears"
      ]
    }
  ]
