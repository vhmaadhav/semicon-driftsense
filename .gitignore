# Generated data — regenerate with generate_dataset.py / scripts/gen_data.py.
data/
sample/
output/

# Environment / caches
venv/
venv-hf/
__pycache__/
*.pyc
.pytest_cache/
.pytest-tmp/
.uv-cache/

# Local editor / agent workspaces
.obsidian/
.codex/
graphify-out/
.dsh/

# Training artifacts. The canonical shipped checkpoint is the only .pt file
# that belongs on the Phase 2 mainline.
logs/
weights/*.pt
!weights/driftsense.pt
weights/*_history.json
weights/*_e[0-9]*.pt

# Evaluation scratch output. Curated result files may be force-added when they
# are intentionally part of a report.
results/*/

# Agent/research scratch outputs. Keep the Markdown decision/evidence docs, not
# per-run logs and giant per-pair CSVs.
.agents/*.log
.agents/*.csv
.agents/*.tsv
.agents/hf_port_state.tsv

# HF port staging/upload state
.hf_stage/
